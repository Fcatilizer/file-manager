# S3 / MinIO
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=your-public-bucket
MINIO_PRIVATE_BUCKET=your-private-bucket
MINIO_ENDPOINT=http://localhost:9000
# Optional: browser-reachable HTTPS S3 endpoint when MINIO_ENDPOINT is internal.
# Signs uploads against this endpoint; defaults to MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_REGION=us-east-1

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
MONGO_DB=vault

# Auth
# The admin below is OPTIONAL. If you leave it blank, the app shows a
# first-run "Create admin" screen when no users exist in the database.
# Generate a JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=replace-with-a-long-random-hex-string
SESSION_TTL=7d

# Optional: require this token to complete first-run setup (recommended on public deploys).
# Leave blank to allow open first-run setup.
SETUP_TOKEN=

# Server
PORT=3000
NODE_ENV=development
