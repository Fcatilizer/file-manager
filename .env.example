# S3 / MinIO
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=your-public-bucket
MINIO_PRIVATE_BUCKET=your-private-bucket
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
MONGO_DB=vault

# Auth — set a strong admin password and a random JWT secret.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-hex-string
SESSION_TTL=7d

# Server
PORT=3000
NODE_ENV=development
