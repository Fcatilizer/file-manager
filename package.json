{
  "name": "file-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "oxlint",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate:animations": "tsx scripts/migrate-animation-preferences.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "mongodb": "^7.7.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
